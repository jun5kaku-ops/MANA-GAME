/* =========================================================
   bgm.js — BGM（おんがく）
   おんがくファイルは つかわず、ブラウザの Web Audio API で
   その場で おとを つくる（ファイルサイズ ゼロ・よみこみ まちなし）
   ゆかいで、うるさすぎない おとを めざした つくり：
   ・サイン波＋三角波のみ（とがった おとを つかわない）
   ・ローパスフィルターで たかい おとを やわらげる
   ・おとの たちあがり／きえぎわを なめらかに する
   ========================================================= */

/* おんかい（ペンタトニック中心）と おと の たかさ */
const MIDI=m=>440*Math.pow(2,(m-69)/12);

/* きょくの データ
   bpm   ： はやさ
   chords： 1しょうせつごとの わおん（MIDIばんごう）
   mel   ： [おとのたかさ, ながさ(はくすう)]  0 は やすみ
   wave  ： メロディの おとしょく
   feel  ： 'bounce'（はねる）/'calm'（しずか）             */
const BGM_TRACKS={
  title:{ bpm:112, wave:'triangle', feel:'bounce',
    chords:[[60,64,67],[57,60,64],[65,69,72],[67,71,74]],
    mel:[[72,1],[74,.5],[76,.5],[79,1],[76,1],  [72,1],[69,.5],[72,.5],[74,2],
         [77,1],[76,.5],[74,.5],[72,1],[74,1],  [79,1.5],[76,.5],[72,2]] },
  map:{ bpm:96, wave:'sine', feel:'calm',
    chords:[[60,64,67],[62,65,69],[57,60,64],[65,69,72]],
    mel:[[76,1.5],[74,.5],[72,2],  [74,1],[76,1],[79,2],
         [76,1.5],[72,.5],[69,2],  [72,1],[74,1],[72,2]] },
  adventure:{ bpm:126, wave:'triangle', feel:'bounce',
    chords:[[60,64,67],[65,69,72],[62,65,69],[67,71,74]],
    mel:[[72,.5],[76,.5],[79,1],[76,.5],[72,.5],[74,1],
         [77,.5],[81,.5],[79,1],[76,.5],[72,.5],[74,1],
         [74,.5],[77,.5],[81,1],[79,.5],[76,.5],[74,1],
         [79,1],[76,.5],[74,.5],[72,2]] },
  kumo:{ bpm:84, wave:'sine', feel:'calm',
    chords:[[65,69,72],[60,64,67],[62,65,69],[67,71,74]],
    mel:[[81,2],[79,1],[76,1],  [77,2],[72,2],
         [74,1],[77,1],[79,2],  [76,2],[72,2]] },
  ending:{ bpm:72, wave:'sine', feel:'calm',
    chords:[[60,64,67],[57,60,64],[65,69,72],[55,59,62]],
    mel:[[72,2],[71,1],[69,1],  [67,2],[64,2],
         [65,1],[67,1],[69,2],  [67,2],[60,2]] },
  mini:{ bpm:134, wave:'triangle', feel:'bounce',
    chords:[[60,64,67],[62,65,69],[65,69,72],[67,71,74]],
    mel:[[72,.5],[74,.5],[76,.5],[77,.5],[79,1],[77,1],
         [76,.5],[74,.5],[72,.5],[74,.5],[76,1],[72,1],
         [77,.5],[79,.5],[81,.5],[79,.5],[77,1],[76,1],
         [74,.5],[76,.5],[79,1],[76,1],[72,1]] }
};

/* おおきさ（3だんかい）。0 は おと なし */
const BGM_VOLS=[0, 0.10, 0.18, 0.28];

const BGM=(()=>{
  let ctx=null, master=null, filt=null;
  let timer=null, key=null, wanted=null, started=false;
  let bar=0, nextT=0;

  const vol=()=>{
    const v=(typeof save!=='undefined' && typeof save.bgm==='number')?save.bgm:2;
    return BGM_VOLS[Math.max(0,Math.min(3,v))];
  };

  function ensure(){
    if(ctx) return true;
    const AC=window.AudioContext||window.webkitAudioContext;
    if(!AC) return false;
    try{
      ctx=new AC();
      filt=ctx.createBiquadFilter(); filt.type='lowpass'; filt.frequency.value=2600; filt.Q.value=0.4;
      master=ctx.createGain(); master.gain.value=0;
      filt.connect(master); master.connect(ctx.destination);
    }catch(e){ ctx=null; return false; }
    return true;
  }

  /* ひとつの おとを ならす */
  function tone(freq,t,dur,type,peak,detune){
    const o=ctx.createOscillator(), g=ctx.createGain();
    o.type=type; o.frequency.value=freq;
    if(detune) o.detune.value=detune;
    g.gain.setValueAtTime(0.0001,t);
    g.gain.exponentialRampToValueAtTime(Math.max(peak,0.0002),t+0.03);
    g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
    o.connect(g); g.connect(filt);
    o.start(t); o.stop(t+dur+0.05);
  }

  /* 1しょうせつぶん を よやくする */
  function scheduleBar(tr,t0,spb){
    const ch=tr.chords[bar%tr.chords.length];
    /* わおん（やわらかい パッド）*/
    ch.forEach((m,i)=>tone(MIDI(m),t0,spb*3.6,'sine',0.045,i?4:0));
    /* ベース */
    const root=ch[0]-24;
    tone(MIDI(root),t0,spb*1.5,'sine',0.085);
    tone(MIDI(root),t0+spb*2,spb*1.5,'sine',0.07);
    if(tr.feel==='bounce'){
      tone(MIDI(ch[1]-12),t0+spb*1,spb*0.5,'sine',0.05);
      tone(MIDI(ch[1]-12),t0+spb*3,spb*0.5,'sine',0.05);
    }
    /* メロディ（きょく ぜんたいを ながれで ならす）*/
    let beat=0, idx=barMelIndex(tr,bar);
    while(beat<4 && idx<tr.mel.length){
      const [m,d]=tr.mel[idx];
      if(m) tone(MIDI(m),t0+beat*spb,spb*d*0.92,tr.wave,0.075);
      beat+=d; idx++;
    }
  }
  /* しょうせつの あたまが メロディの どこか を もとめる */
  function barMelIndex(tr,b){
    const total=tr.mel.reduce((a,x)=>a+x[1],0);
    const bars=Math.max(1,Math.round(total/4));
    let want=(b%bars)*4, acc=0;
    for(let i=0;i<tr.mel.length;i++){
      if(acc>=want) return i;
      acc+=tr.mel[i][1];
    }
    return 0;
  }

  function loop(){
    if(!ctx||!key) return;
    const tr=BGM_TRACKS[key]; if(!tr) return;
    const spb=60/tr.bpm;
    while(nextT < ctx.currentTime+1.2){
      if(nextT < ctx.currentTime) nextT=ctx.currentTime+0.06;
      scheduleBar(tr,nextT,spb);
      nextT+=spb*4; bar++;
    }
  }

  function fade(to,sec){
    if(!master||!ctx) return;
    const now=ctx.currentTime;
    master.gain.cancelScheduledValues(now);
    master.gain.setValueAtTime(Math.max(master.gain.value,0.0001),now);
    master.gain.linearRampToValueAtTime(to,now+sec);
  }

  return {
    /* さいしょの タップで おとを つかえるように する */
    unlock(){
      if(!ensure()) return;
      if(ctx.state==='suspended') ctx.resume().catch(()=>{});
      started=true;
      if(wanted) this.play(wanted);
    },
    /* きょくを かえる（おなじ きょくなら なにも しない）*/
    play(k){
      wanted=k;
      if(!started||!ensure()) return;
      if(ctx.state==='suspended') ctx.resume().catch(()=>{});
      if(key===k){ fade(vol(),0.4); return; }
      key=k; bar=0; nextT=ctx.currentTime+0.08;
      if(timer) clearInterval(timer);
      if(!BGM_TRACKS[k]){ fade(0,0.4); key=null; return; }
      fade(vol(),0.8);
      loop();
      timer=setInterval(loop,500);
    },
    stop(){ if(timer){clearInterval(timer);timer=null;} key=null; fade(0,0.3); },
    /* せっていが かわった ときに よぶ */
    refresh(){ if(key) fade(vol(),0.3); if(vol()===0) this.stop(); else if(wanted&&!key) this.play(wanted); },
    isOn(){ return vol()>0; }
  };
})();
