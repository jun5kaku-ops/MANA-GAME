/* =========================================================
   mini.js — ミニゲーム（コンプリートの ごほうび）
   ・アイスキャッチ  ：アイス24こ ぜんぶ あつめると あそべる
   ・どうぶつ タッチ  ：おともだち ぜんいんに あうと あそべる
   ・もじ ハンター    ：もじを 92こ ぜんぶ かくと あそべる
   まけは なし。じかんが きたら みんな ごほうびの がめん。
   ========================================================= */

const MINI_LIST=[
  {id:'catch', n:'アイスキャッチ', e:'🍦', need:'ice',  lock:'アイスを ぜんぶ あつめると あそべるよ'},
  {id:'touch', n:'どうぶつ タッチ', e:'👋', need:'char', lock:'おともだち ぜんいんに あうと あそべるよ'},
  {id:'hunt',  n:'もじ ハンター',  e:'✏️', need:'kana', lock:'もじを ぜんぶ かくと あそべるよ'}
];
const miniOpen=need=>{
  if(need==='ice')  return save.owned.length>=ICES.length;
  if(need==='char') return (save.chars||[]).length>=ALL_CHARS.length;
  if(need==='kana') return (save.wrote||[]).length>=92;
  return false;
};
const miniBest=id=>((save.best||{})[id]||0);
function miniSaveBest(id,v){
  if(!save.best) save.best={};
  if(v>(save.best[id]||0)){ save.best[id]=v; persist(); return true; }
  return false;
}

/* ---------- ミニゲームの えらぶ がめん ---------- */
function showMiniHub(){
  A=null; stopSpeak(); setBG('title');
  if(typeof BGM!=='undefined') BGM.play('mini');
  const anyOpen=MINI_LIST.some(m=>miniOpen(m.need));
  app.innerHTML=`<div class="top"><button class="icon" id="homeBtn">🏠</button><div class="pts">🎮</div></div>
    <div class="h2">🎮 ミニゲーム</div>
    <div class="list">
      ${MINI_LIST.map((m,i)=>{ const ok=miniOpen(m.need);
        return `<div class="item"><div class="em">${ok?m.e:'🔒'}</div>
          <div class="nm">${ok?m.n:'？？？'}<small>${ok?('さいこう きろく：'+miniBest(m.id)):m.lock}</small></div>
          ${ok?`<button class="btn c3" data-mini="${m.id}">あそぶ</button>`:`<div class="btn c1" style="min-height:52px;font-size:17px;opacity:.5">🔒</div>`}</div>`;}).join('')}
    </div>
    <div class="note">${anyOpen?'とくてんは いつでも あそべるよ':'コンプリートすると あそべるように なるよ'}</div>`;
  $('#homeBtn').onclick=showTitle;
  app.querySelectorAll('[data-mini]').forEach(b=>b.onclick=()=>startMini(b.dataset.mini));
  speak(anyOpen?'ミニゲームで あそぼう':'コンプリートすると あそべるように なるよ');
}

function startMini(id){
  if(id==='catch') miniCatch();
  else if(id==='touch') miniTouch();
  else miniHunt();
}

/* ---------- けっかの がめん ---------- */
function miniResult(id,score,unit,praise){
  const rec=miniSaveBest(id,score);
  const g=MINI_LIST.find(m=>m.id===id);
  app.innerHTML=`<div class="top"><button class="icon" id="homeBtn">🏠</button><div class="pts">🎮</div></div>
    <div class="stage big"><div class="main">${g.e}</div></div>
    <div class="bubble"><div class="txt">${praise}<br>${score} ${unit}！${rec?'<br>🏆 さいこう きろく こうしん！':''}</div><button class="say">🔊</button></div>
    <div class="choices two">
      <button class="btn c3" id="again"><b>🔁</b>もういちど</button>
      <button class="btn c4" id="back"><b>🎮</b>ゲームを えらぶ</button>
    </div>`;
  $('#homeBtn').onclick=showTitle;
  const sayTxt=clean(praise)+' '+score+unit+'！'+(rec?' さいこう きろく こうしん！':'');
  const s=$('.say'); if(s) s.onclick=()=>speak(sayTxt);
  $('#again').onclick=()=>startMini(id);
  $('#back').onclick=showMiniHub;
  burst(rec?26:16); speak(sayTxt);
}

/* =========================================================
   1. アイスキャッチ — おちてくる アイスを カゴで うける
   ========================================================= */
function miniCatch(){
  const DUR=30;
  app.innerHTML=`<div class="top"><button class="icon" id="homeBtn">🏠</button>
      <div class="party" style="font-size:19px;font-weight:900" id="mScore">🍦 0</div>
      <div class="pts" id="mTime">⏱ ${DUR}</div></div>
    <div class="mfield" id="field"><div class="basket" id="basket">🧺</div></div>
    <div class="note">ゆびを よこに うごかして アイスを うけとめよう</div>`;
  const field=$('#field'), basket=$('#basket');
  let score=0, left=DUR, items=[], raf=null, last=0, spawn=0, bx=0.5, over=false;
  const FALL=['🍦','🍨','🍧','🍡','🍓','⭐'];
  $('#homeBtn').onclick=()=>{ over=true; if(raf)cancelAnimationFrame(raf); if(tick)clearInterval(tick); showMiniHub(); };

  const setX=cx=>{ const r=field.getBoundingClientRect();
    bx=Math.max(0.07,Math.min(0.93,(cx-r.left)/r.width));
    basket.style.left=(bx*100)+'%'; };
  const move=ev=>{ ev.preventDefault(); const t=ev.touches?ev.touches[0]:ev; setX(t.clientX); };
  field.addEventListener('pointerdown',move);
  field.addEventListener('pointermove',ev=>{ if(ev.buttons||ev.pointerType==='touch') move(ev); });
  field.addEventListener('touchmove',move,{passive:false});
  basket.style.left='50%';

  const tick=setInterval(()=>{
    if(over) return;
    left--; $('#mTime').textContent='⏱ '+left;
    if(left<=0){ over=true; clearInterval(tick); if(raf)cancelAnimationFrame(raf);
      setTimeout(()=>miniResult('catch',score,'こ ゲット','じょうず！ いっぱい とれたね！'),400); }
  },1000);

  function frame(t){
    if(over) return;
    if(!last) last=t;
    const dt=Math.min(50,t-last)/1000; last=t;
    spawn-=dt;
    if(spawn<=0){
      spawn=0.42+Math.random()*0.32;
      const el=document.createElement('span');
      el.className='falling'; el.textContent=FALL[Math.floor(Math.random()*FALL.length)];
      el.style.left=(6+Math.random()*88)+'%'; el.style.top='-8%';
      field.appendChild(el);
      items.push({el,x:parseFloat(el.style.left)/100,y:-0.08,v:0.30+Math.random()*0.22});
    }
    for(let i=items.length-1;i>=0;i--){
      const it=items[i]; it.y+=it.v*dt; it.el.style.top=(it.y*100)+'%';
      if(it.y>0.80 && it.y<0.99 && Math.abs(it.x-bx)<0.12){
        score++; $('#mScore').textContent='🍦 '+score;
        it.el.classList.add('got'); const e=it.el; setTimeout(()=>e.remove(),300);
        items.splice(i,1); continue;
      }
      if(it.y>1.05){ it.el.remove(); items.splice(i,1); }
    }
    raf=requestAnimationFrame(frame);
  }
  raf=requestAnimationFrame(frame);
  speak('アイスを うけとめてね！ よーい、 スタート！');
}

/* =========================================================
   2. どうぶつ タッチ — よばれた こを タッチ
   ========================================================= */
function miniTouch(){
  const ROUNDS=10;
  let round=0, score=0, locked=false;
  const pool=ALL_CHARS.filter(c=>c.l);
  next();
  function next(){
    if(round>=ROUNDS){
      setTimeout(()=>miniResult('touch',score,'にん せいかい','よく みつけたね！'),400); return;
    }
    round++; locked=false;
    const six=shuffle(pool).slice(0,6);
    const ans=six[Math.floor(Math.random()*6)];
    app.innerHTML=`<div class="top"><button class="icon" id="homeBtn">🏠</button>
        <div class="party" style="font-size:19px;font-weight:900">${round} / ${ROUNDS}</div>
        <div class="pts">⭕ ${score}</div></div>
      <div class="bubble mini"><div class="txt">「${hon(ans.n)}」は どこ？</div><button class="say">🔊</button></div>
      <div class="mgrid">${six.map(c=>`<button class="mcell" data-n="${c.n}">${art(c.n,54)}</button>`).join('')}</div>`;
    $('#homeBtn').onclick=showMiniHub;
    const readIt=()=>speak(hon(ans.n)+'は どこ？');
    const s=$('.say'); if(s) s.onclick=readIt; readIt();
    app.querySelectorAll('[data-n]').forEach(b=>b.onclick=()=>{
      if(locked) return;
      if(b.dataset.n===ans.n){ locked=true; b.classList.add('right'); score++;
        showWord('せいかい！'); burst(10); speak('せいかい！ '+hon(ans.n)+'！'); setTimeout(next,1100); }
      else{ b.classList.remove('wrong'); void b.offsetWidth; b.classList.add('wrong');
        speak('もういちど。 '+hon(ans.n)+'を さがしてね'); }
    });
  }
}

/* =========================================================
   3. もじ ハンター — でてくる もじの なかから おなじ もじを タッチ
   ========================================================= */
function miniHunt(){
  const DUR=30;
  let score=0, left=DUR, over=false, locked=false;
  const all=(typeof ALL_KANA!=='undefined')?Object.keys(ALL_KANA):HIRA.map(h=>h[0][0]);
  round();
  const tick=setInterval(()=>{
    if(over) return;
    left--; const el=$('#mTime'); if(el) el.textContent='⏱ '+left;
    if(left<=0){ over=true; clearInterval(tick);
      setTimeout(()=>miniResult('hunt',score,'もじ せいかい','もじ ハンター、 だいせいこう！'),400); }
  },1000);
  function round(){
    if(over) return;
    locked=false;
    const pick9=shuffle(all).slice(0,9);
    const ans=pick9[Math.floor(Math.random()*9)];
    app.innerHTML=`<div class="top"><button class="icon" id="homeBtn">🏠</button>
        <div class="party" style="font-size:19px;font-weight:900">⭕ ${score}</div>
        <div class="pts" id="mTime">⏱ ${left}</div></div>
      <div class="bubble mini"><div class="txt">「${ans}」は どこ？</div><button class="say">🔊</button></div>
      <div class="hgrid">${pick9.map(k=>`<button class="hcell" data-k="${k}">${k}</button>`).join('')}</div>`;
    $('#homeBtn').onclick=()=>{ over=true; clearInterval(tick); showMiniHub(); };
    const kata=c=>String(c).replace(/[ぁ-ん]/g,m=>String.fromCharCode(m.charCodeAt(0)+0x60));
    const readIt=()=>speak(kata(ans)+'は どこ？');
    const s=$('.say'); if(s) s.onclick=readIt; readIt();
    app.querySelectorAll('[data-k]').forEach(b=>b.onclick=()=>{
      if(locked||over) return;
      if(b.dataset.k===ans){ locked=true; b.classList.add('right'); score++; burst(8);
        speak('せいかい！'); setTimeout(round,600); }
      else{ b.classList.remove('wrong'); void b.offsetWidth; b.classList.add('wrong'); speak('もういちど'); }
    });
  }
}
